<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" stylesheets="@../assets/styles/main.css" xmlns="http://javafx.com/javafx/20.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.speedtech_automotive.controller.SubDashBoardFormController">
   <children>
      <BarChart fx:id="barChart" prefHeight="249.0" prefWidth="385.0" styleClass="chart-bar" >
        <xAxis>
          <CategoryAxis label="Monthly Totals" side="BOTTOM" styleClass="chart-bar" fx:id="xAxis" style="-fx-bar: blue;" />
        </xAxis>
        <yAxis>
          <NumberAxis fx:id="yAxis" label="Total Sales" side="LEFT" styleClass="chart-bar" style="-fx-bar: blue; "/>
        </yAxis>
      </BarChart>
   </children>
</AnchorPane>